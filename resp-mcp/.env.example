# Copy to .env and fill in. Never commit .env.
# Delphi Epidata key, registered under PubHealth Commons (decision 0001).
DELPHI_API_KEY=
# Socrata app token, registered under PubHealth Commons. One token works on data.cdc.gov and health.data.ny.gov.
SOCRATA_APP_TOKEN=
# Path to the DuckDB file.
RESPMCP_DB_PATH=data/respmcp.duckdb
# Set to 1 to run integration tests and scripts that call live APIs.
RESPMCP_LIVE=0
# Phase 5 only. Leave blank to keep the notice classifier off.
TYPESAFE_API_KEY=
